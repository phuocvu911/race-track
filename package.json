{
  "name": "race-track",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "TIMER_MINUTES=1 node --env-file-if-exists=.env --watch server.js",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "prepare": "lefthook install"
  },
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "lefthook": "2.2.2"
  }
}
