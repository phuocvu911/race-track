{
  "name": "race-track",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "vite build client",
    "start": "npm run build && node --env-file-if-exists=.env server.js",
    "dev": "npm run build && TIMER_MINUTES=1 node --env-file-if-exists=.env --watch server.js",
    "dev:client": "vite client",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "prepare": "lefthook install"
  },
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "lefthook": "2.2.2",
    "svelte": "^5.57.3",
    "vite": "^8.3.8"
  }
}
